{
  "name": "ai-control-center",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "triggers": {"crons": ["*/5 * * * *"]},
  "d1_databases": [
    {
      "binding": "ORG_DB",
      "database_name": "ai-control-center-orgs",
      "database_id": "e4046f53-3061-4fce-a1a1-9bb7ba796df6"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
